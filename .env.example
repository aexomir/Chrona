# Sentry DSN — safe to expose client-side, gets bundled into the JS build.
# Leave unset locally to run with Sentry disabled (lib/sentry.ts no-ops).
EXPO_PUBLIC_SENTRY_DSN=

# Required only for EAS builds to upload source maps/debug symbols.
# Set these as EAS secrets (`eas secret:create`) — never commit real values.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
