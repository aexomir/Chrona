{
  "expo": {
    "name": "Chrona",
    "slug": "Chrona",
    "version": "1.0.35",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chrona",
    "userInterfaceStyle": "dark",
    "ios": {
      "appleTeamId": "998C8ZCRMH",
      "supportsTablet": true,
      "bundleIdentifier": "com.aexomir.Chrona",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Chrona uses your calendar to suggest projects for upcoming events.",
        "NSLocalNetworkUsageDescription": "Chrona connects to Chrona Helper on your Mac to show which app you're currently using.",
        "NSBonjourServices": [
          "_chrona._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18181b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aexomir.Chrona"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "macos": {
      "icon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18181b",
          "dark": {
            "backgroundColor": "#18181b"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Chrona uses your calendar to suggest projects for upcoming events."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.aexomir.Chrona",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "ChronaTimeWidget",
              "displayName": "Chrona Time",
              "description": "Your focus time and active project at a glance.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            },
            {
              "name": "TimelineWidget",
              "displayName": "Timeline",
              "description": "Your Chrona sessions for today at a glance.",
              "supportedFamilies": [
                "systemMedium",
                "systemLarge"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
