{
  "expo": {
    "name": "Focus",
    "slug": "Focus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "focus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "998C8ZCRMH",
      "supportsTablet": true,
      "bundleIdentifier": "com.aexomir.Focus",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Focus uses your calendar to suggest projects for upcoming events.",
        "AppGroupIdentifier": "group.com.aexomir.Focus",
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.aexomir.Focus"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aexomir.Focus"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18181b",
          "dark": {
            "backgroundColor": "#18181b"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Focus uses your calendar to suggest projects for upcoming events."
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
