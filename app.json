{
  "expo": {
    "name": "Focus",
    "slug": "Focus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "focus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aexomir.Focus",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Focus uses your calendar to suggest projects for upcoming events."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aexomir.Focus"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Focus uses your calendar to suggest projects for upcoming events."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "FocusTimeWidget",
              "displayName": "Focus Time",
              "description": "See your daily focus time at a glance.",
              "supportedFamilies": ["systemSmall", "systemMedium"],
              "contentMarginsDisabled": true
            },
            {
              "name": "StreakWidget",
              "displayName": "Focus Streak",
              "description": "Track your daily focus streak.",
              "supportedFamilies": ["systemSmall"],
              "contentMarginsDisabled": true
            },
            {
              "name": "GoalProgressWidget",
              "displayName": "Focus Goal",
              "description": "Track your progress toward today's focus goal.",
              "supportedFamilies": ["systemSmall", "systemMedium"],
              "contentMarginsDisabled": true
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
