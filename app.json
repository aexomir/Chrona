{
  "expo": {
    "name": "Chrona",
    "slug": "Chrona",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chrona",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "998C8ZCRMH",
      "supportsTablet": true,
      "bundleIdentifier": "com.aexomir.Chrona",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Chrona uses your calendar to suggest projects for upcoming events.",
        "NSLocalNetworkUsageDescription": "Chrona connects to Chrona Helper on your Mac to show which app you're currently using.",
        "NSBonjourServices": [
          "_chrona._tcp"
        ],
        "AppGroupIdentifier": "group.com.aexomir.Chrona",
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.aexomir.Chrona"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aexomir.Chrona"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "macos": {
      "icon": "./assets/images/icon.png"
    },
    "watchos": {
      "icon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18181b",
          "dark": {
            "backgroundColor": "#18181b"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Chrona uses your calendar to suggest projects for upcoming events."
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
